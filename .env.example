# ─────────────────────────────────────────────────────────────────────────────
# Environment variable reference (NO real values here — keep secrets out of git).
#
# Local dev: real values live in `backend/config/.env` (backend) and
#            `frontend/.env` (VITE_* — read at BUILD time by Vite).
# Render:    set every var below in the dashboard → Environment.
#            Do NOT set PORT — Render injects it automatically.
# ─────────────────────────────────────────────────────────────────────────────

# --- Backend (process.env.*) ---
NODE_ENV=production
DB_STRING=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>
SESSION_SECRET=<long-random-string>
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
# Public origin of the deployed app, NO trailing slash.
# Prod e.g. https://todo-mvc-auth-local.onrender.com   Dev: omit (falls back to http://localhost:PORT)
BASE_URL=https://<your-app>.onrender.com

# --- Frontend (VITE_*) — baked into the build, must be present BEFORE `npm run build` ---
VITE_GOOGLEMAPS_API_KEY=<google-maps-browser-key>
VITE_CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
VITE_CLOUDINARY_UPLOAD_PRESET=<cloudinary-unsigned-preset>
